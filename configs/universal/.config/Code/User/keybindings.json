[
    {
        "key": "ctrl+j",
        "command": "noop",
        "when": "terminalFocus"
    },
    {
        "key": "ctrl+k",
        "command": "noop",
        "when": "terminalFocus"
    },
    {
        "key": "ctrl+e",
        "command": "noop",
        "when": "terminalFocus"
    },
    {
        "key": "ctrl+p",
        "command": "noop",
        "when": "terminalFocus"
    },
    {
        "key": "ctrl+shift+i",
        "command": "editor.action.formatSelection",
        "when": "editor.hasSelection"
    },
    /* https://marketplace.visualstudio.com/items?itemName=vscodevim.vim */
    {
        "key": "ctrl+p",
        "command": "selectPrevSuggestion",
        "when": "suggestWidgetMultipleSuggestions && suggestWidgetVisible && textInputFocus || suggestWidgetVisible && textInputFocus && !suggestWidgetHasFocusedSuggestion"
    },
    // /* https://marketplace.visualstudio.com/items?itemName=tuttieee.emacs-mcx */
    // {
    //     "key": "shift+alt+/",
    //     "command": "editor.action.goToReferences",
    //     "when": "config.emacs-mcx.useMetaPrefixAlt && editorHasReferenceProvider"
    // },
    /* https://marketplace.visualstudio.com/items?itemName=SeungukShin.cscope-code */
    {
        "key": "ctrl+c ctrl+g",
        "command": "cscope-code:definition",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+c g",
        "command": "cscope-code:definition-input",
        "when": "editorFocus"
    },
    {
        "key": "ctrl+c ctrl+r",
        "command": "cscope-code:caller",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+c r",
        "command": "cscope-code:caller-input",
        "when": "editorFocus"
    }
]
